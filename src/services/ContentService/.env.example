# ==============================================================================
# ContentService Multi-Node Docker Compose Configuration
# Copy this file to ".env" in src/services/ContentService/ before running:
#   docker compose up --build
# ==============================================================================

# --- Database (SQL Server per storage node) ---
SQL_SA_PASSWORD=Oekolariet_Dev123!
SQL_NODE_1_PORT=14331
SQL_NODE_2_PORT=14332

# --- ASP.NET Core Host ---
ASPNETCORE_ENVIRONMENT=Development
# Optional browser origin allowed by ContentService CORS policy (e.g., EditorService UI or local ContentService.Web showcase)
CORS_ALLOWED_ORIGIN_0=http://localhost:5000

# --- Backing Infrastructure Ports ---
REDIS_PORT=6379
DAPR_PLACEMENT_PORT=50006

# --- Storage Node 1 ---
NODE_1_STORAGE_ID=node-1
NODE_1_HTTP_PORT=5101
NODE_1_PUBLIC_BASE_URL=http://localhost:5101

# --- Storage Node 2 ---
NODE_2_STORAGE_ID=node-2
NODE_2_HTTP_PORT=5102
NODE_2_PUBLIC_BASE_URL=http://localhost:5102

# --- Storage Pool & Quota Settings ---
POOL_REQUEST_TIMEOUT_SECONDS=5
CONTENT_MAX_IMAGE_SIZE_BYTES=10485760
CONTENT_TOTAL_QUOTA_BYTES=5368709120

