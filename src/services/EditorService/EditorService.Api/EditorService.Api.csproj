<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <!-- Shown in Swagger. Asp.Versioning.OpenApi reads the title and description from these. -->
    <AssemblyTitle>Editor Service API</AssemblyTitle>
    <Description>Create and edit sorting games and quizzes. Service version $(Version).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EditorService.Application\EditorService.Application.csproj" />
    <ProjectReference Include="..\EditorService.Infrastructure\EditorService.Infrastructure.csproj" />
    <ProjectReference Include="..\EditorService.Sdk\EditorService.Sdk.csproj" />
  </ItemGroup>

</Project>
