        <!-- Title Banner -->
        <mxCell id="p2-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;ContentService — Clean Architecture &amp;amp; Project Dependency Map&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#475569&quot;&gt;8 Production Projects  |  Blazor WASM Client Stack (Left)  •  Core Clean Architecture Layers (Center)  •  Infrastructure Adapters (Right)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=18;fontFamily=Segoe UI;fontColor=#0F172A;" vertex="1" parent="1">
