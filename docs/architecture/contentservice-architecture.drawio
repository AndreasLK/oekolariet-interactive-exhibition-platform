        <mxCell id="p1-node2-dapr" value="&lt;b&gt;Dapr Sidecar 2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;HTTP :3500&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• App ID:&lt;br&gt;  &lt;i&gt;contentservice-node-2&lt;/i&gt;&lt;br&gt;• Shared network&lt;br&gt;  namespace&lt;br&gt;• Pub/Sub + Invoke" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#1E293B;" vertex="1" parent="1">
