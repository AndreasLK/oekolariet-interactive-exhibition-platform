        <mxCell id="p1-node1-api" value="&lt;b&gt;ContentService.Api (Node 1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Host :5101 → Container :8080&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• Versioned REST: &lt;b&gt;/api/v1/images&lt;/b&gt;, &lt;b&gt;/templates&lt;/b&gt;&lt;br&gt;• Publishing &amp;amp; Health: &lt;b&gt;/publish/bundles&lt;/b&gt;, &lt;b&gt;/storage-health&lt;/b&gt;&lt;br&gt;• Dapr Endpoints: &lt;b&gt;/dapr/subscribe&lt;/b&gt;, &lt;b&gt;/api/v1/pool/*&lt;/b&gt;&lt;br&gt;• SkiaSharp WebP Previews &amp;amp; Magic-Byte Validation&lt;br&gt;• RFC 7807 GlobalExceptionHandler" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#1E293B;" vertex="1" parent="1">
