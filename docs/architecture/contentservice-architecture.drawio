        <mxCell id="p2-web" value="&lt;b&gt;ContentService.Web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Blazor WebAssembly Host&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• Program.cs registers ALKsPersonalUI theme&lt;br&gt;  (&lt;i&gt;OekolarietContent&lt;/i&gt;) &amp;amp; ContentService.Sdk&lt;br&gt;• Pages/Home.razor &amp;amp; Layout/MainLayout.razor&lt;br&gt;• Pure C#/Razor (No custom JS)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="52" y="150" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="p2-components" value="&lt;b&gt;ContentService.Components&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Reusable Razor Component Library&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;ContentImageGallery&lt;/b&gt; &amp;amp; &lt;b&gt;ContentAlbumBreadcrumbBar&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ContentImageUploadModal&lt;/b&gt; &amp;amp; Batch Uploader&lt;br&gt;• &lt;b&gt;ContentImageDetailModal&lt;/b&gt; &amp;amp; &lt;b&gt;MetadataEditor&lt;/b&gt;&lt;br&gt;• &lt;b&gt;GalleryLoadCoordinator&lt;/b&gt; &amp;amp; Path Normalizer&lt;br&gt;• Built on ALKsPersonalUI primitives" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
