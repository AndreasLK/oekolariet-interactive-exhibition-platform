        <mxCell id="p2-api" value="&lt;b&gt;ContentService.Api&lt;/b&gt;  &lt;font color=&quot;#64748B&quot;&gt;(ASP.NET Core Minimal API Host &amp;amp; Composition Root)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;Images&lt;/b&gt; (/api/v1/images): Upload, List, Albums, Batch Metadata, Get, Patch, Content, Preview, Delete&lt;br&gt;• &lt;b&gt;Templates&lt;/b&gt; (/api/v1/templates): Create, List, Get, Update, Delete, Image-Reference Check&lt;br&gt;• &lt;b&gt;Publishing &amp;amp; Health&lt;/b&gt;: POST /publish/bundles, GET /storage-health, GET /healthz&lt;br&gt;• &lt;b&gt;Pool &amp;amp; Dapr&lt;/b&gt;: /dapr/subscribe, /pool/events/*, /pool/replies/{id}, /pool/upload-offers&lt;br&gt;• &lt;b&gt;Cross-Cutting&lt;/b&gt;: GlobalExceptionHandler (RFC 7807), CORS, URL Versioning, OpenAPI" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="515" y="148" width="610" height="175" as="geometry" />
        </mxCell>

        <mxCell id="p2-facade" value="&lt;b&gt;ContentService.Facade&lt;/b&gt;  &lt;font color=&quot;#64748B&quot;&gt;(API Boundary &amp;amp; DTO Anti-Corruption Layer)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;Services&lt;/b&gt;: IImageCommandFacade, IImageQueryFacade, ITemplateCommandFacade,&lt;br&gt;  ITemplateQueryFacade, IContentPlatformQueryFacade, IPoolFacade&lt;br&gt;• &lt;b&gt;Mapping&lt;/b&gt;: FacadeMapper translates Application models ↔ Stable Boundary DTOs" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="515" y="372" width="610" height="125" as="geometry" />
        </mxCell>

        <mxCell id="p2-app" value="&lt;b&gt;ContentService.Application&lt;/b&gt;  &lt;font color=&quot;#64748B&quot;&gt;(Use Cases, Orchestration &amp;amp; Port Interfaces)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;Use Cases&lt;/b&gt;: Images (Upload, Stream, Preview, Metadata, Delete, Albums), Templates (CRUD + Ref Check),&lt;br&gt;  Publishing (ResolvePublishBundle + Checksum), Health (GetStorageHealth)&lt;br&gt;• &lt;b&gt;Domain Support&lt;/b&gt;: MagicByteImageSignatureValidator, StorageNodeTargetResolver, ReferencedImageVerifier&lt;br&gt;• &lt;b&gt;Ports (Interfaces)&lt;/b&gt;: IImageRepository, IImageBinaryStore, ITemplateRepository, IStorageQuotaMonitor,&lt;br&gt;  IImagePreviewGenerator, IPoolCoordinator, IStorageNodeClient" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
