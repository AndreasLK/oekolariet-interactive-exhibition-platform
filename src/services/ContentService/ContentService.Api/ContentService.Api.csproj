<Project Sdk="Microsoft.NET.Sdk.Web">

        <PropertyGroup>
                <TargetFramework>net11.0</TargetFramework>
                <ImplicitUsings>enable</ImplicitUsings>
                <Nullable>enable</Nullable>
                <!-- Emit XML docs and enforce CS1591/CS1573 from .editorconfig across all API types. -->
                <GenerateDocumentationFile>true</GenerateDocumentationFile>
        </PropertyGroup>

        <ItemGroup>
                <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
                <PackageReference Include="Asp.Versioning.OpenApi" Version="10.2.3" />
                <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
                <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
                        <PrivateAssets>all</PrivateAssets>
                        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
                </PackageReference>
                <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
        </ItemGroup>

        <ItemGroup>
                <ProjectReference Include="..\ContentService.Domain\ContentService.Domain.csproj" />
                <ProjectReference Include="..\ContentService.Facade\ContentService.Facade.csproj" />
                <ProjectReference Include="..\ContentService.Infrastructure\ContentService.Infrastructure.csproj" />
        </ItemGroup>

</Project>
