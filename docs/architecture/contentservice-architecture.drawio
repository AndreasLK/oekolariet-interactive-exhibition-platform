        <mxCell id="e2-api-infra" value="DI Wire-Up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;dashed=1;dashPattern=3 3;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-api" target="p2-infra-grp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2-infra-app" value="Implements&lt;br&gt;Ports" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;dashed=1;dashPattern=6 4;strokeColor=#16A34A;strokeWidth=2;fontFamily=Segoe UI;fontSize=10.5;fontColor=#15803D;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.62;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-infra-grp" target="p2-app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2-infra-dom" value="Persists&lt;br&gt;Entities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#059669;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#047857;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.87;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-infra-grp" target="p2-domain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================================== -->
  <!-- PAGE 3: DOMAIN MODEL & KEY MULTI-NODE COORDINATION FLOWS              -->
  <!-- ===================================================================== -->
  <diagram id="page-domain-flows" name="3. Domain Model &amp; Pool Flows">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="p3-title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;ContentService — Domain Model &amp;amp; Multi-Node Coordination Flows&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#475569&quot;&gt;Entities, Value Objects, Invariants (Top)  •  Stateless Scatter-Gather Upload Routing &amp;amp; Cross-Node Proxying (Bottom)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=18;fontFamily=Segoe UI;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1640" height="58" as="geometry" />
        </mxCell>

        <!-- ==================== DOMAIN MODEL (TOP) ==================== -->
        <mxCell id="p3-dom-grp" value="&lt;b&gt;Domain Model (ContentService.Domain)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="1640" height="590" as="geometry" />
        </mxCell>

        <!-- BaseEntity -->
        <mxCell id="p3-base" value="&lt;b&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt;&lt;br&gt;BaseEntity&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;+ Id : Guid&lt;br&gt;+ CreatedAtUtc : DateTimeOffset&lt;br&gt;+ CreatedBy : string&lt;br&gt;+ UpdatedAtUtc : DateTimeOffset&lt;br&gt;+ UpdatedBy : string&lt;br&gt;+ RowVersion : byte[] &lt;i&gt;(optimistic lock)&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="55" y="295" width="250" height="175" as="geometry" />
        </mxCell>

        <!-- ImageEntity -->
        <mxCell id="p3-img" value="&lt;b&gt;ImageEntity&lt;/b&gt;  &lt;font color=&quot;#2563EB&quot;&gt;(Aggregate Root)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#BFDBFE&quot;&gt;+ StorageNodeId : string &lt;i&gt;(shard key)&lt;/i&gt;&lt;br&gt;+ FileName : string  |  ContentType : string&lt;br&gt;+ FileSizeBytes : long  |  Sha256Hash : string&lt;br&gt;+ AltText? : string  |  AlbumPath? : string&lt;br&gt;+ Tags? : string  |  IsDeleted : bool &lt;i&gt;(soft delete)&lt;/i&gt;&lt;br&gt;+ ExternalId : string &lt;i&gt;({node}_{guid})&lt;/i&gt;&lt;br&gt;+ Reference : PictureReference &lt;i&gt;(picture.{node}.{guid})&lt;/i&gt;&lt;hr size=&quot;1&quot; color=&quot;#BFDBFE&quot;&gt;+ Create(...)  |  UpdateMetadata(...)  |  MarkDeleted(...)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="385" y="138" width="345" height="240" as="geometry" />
        </mxCell>

        <!-- ImageBinaryEntity -->
        <mxCell id="p3-bin" value="&lt;b&gt;ImageBinaryEntity&lt;/b&gt;  &lt;font color=&quot;#0D9488&quot;&gt;(Split Binary Table)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#99F6E4&quot;&gt;+ ImageId : Guid &lt;i&gt;(PK &amp;amp; FK → ImageEntity.Id)&lt;/i&gt;&lt;br&gt;+ Data : byte[] &lt;i&gt;(raw original binary)&lt;/i&gt;&lt;br&gt;+ PreviewData? : byte[] &lt;i&gt;(WebP thumbnail)&lt;/i&gt;&lt;br&gt;+ PreviewContentType? : string&lt;hr size=&quot;1&quot; color=&quot;#99F6E4&quot;&gt;+ Create(imageId, data)  |  SetPreview(bytes, mime)&lt;br&gt;&lt;i&gt;Kept separate so metadata queries never load MBs&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="835" y="158" width="325" height="200" as="geometry" />
        </mxCell>

        <!-- TemplateEntity -->
        <mxCell id="p3-tpl" value="&lt;b&gt;TemplateEntity&lt;/b&gt;  &lt;font color=&quot;#7C3AED&quot;&gt;(Aggregate Root)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#DDD6FE&quot;&gt;+ StorageNodeId : string  |  Name : string&lt;br&gt;+ ComponentType : TemplateComponentType&lt;br&gt;+ SchemaJson : string &lt;i&gt;(raw UI schema)&lt;/i&gt;&lt;br&gt;+ SchemaVersion : int &lt;i&gt;(monotonic)&lt;/i&gt;&lt;br&gt;+ IsArchived : bool  |  ExternalId : string&lt;br&gt;+ ReferencedImages : IReadOnlyCollection&lt;hr size=&quot;1&quot; color=&quot;#DDD6FE&quot;&gt;+ Create(...)  |  UpdateSchema(...)  |  Archive(...)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="385" y="428" width="345" height="230" as="geometry" />
        </mxCell>

        <!-- TemplateImageReference -->
        <mxCell id="p3-tref" value="&lt;b&gt;TemplateImageReference&lt;/b&gt;  &lt;font color=&quot;#C026D3&quot;&gt;(Indexed Link)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#F5D0FE&quot;&gt;+ TemplateId : Guid &lt;i&gt;(FK → TemplateEntity.Id)&lt;/i&gt;&lt;br&gt;+ StorageNodeId : string&lt;br&gt;+ ImageId : Guid&lt;hr size=&quot;1&quot; color=&quot;#F5D0FE&quot;&gt;• Auto-extracted from Template.SchemaJson&lt;br&gt;• Enables fast delete protection (409 EntityInUse)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=1.8;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="835" y="458" width="325" height="170" as="geometry" />
        </mxCell>

        <!-- Value Objects -->
        <mxCell id="p3-vo" value="&lt;b&gt;Value Objects &amp;amp; Domain Scanners&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#FDE68A&quot;&gt;• &lt;b&gt;PictureReference&lt;/b&gt; (&lt;i&gt;picture.{node}.{guid}&lt;/i&gt; / &lt;i&gt;{node}_{guid}&lt;/i&gt;)&lt;br&gt;  Encodes shard ID for zero-DB-lookup routing&lt;br&gt;• &lt;b&gt;AlbumPath&lt;/b&gt; — Normalized hierarchical album path&lt;br&gt;• &lt;b&gt;ImageTags&lt;/b&gt; — Normalized comma-separated tags&lt;br&gt;• &lt;b&gt;TemplateJsonPictureScanner&lt;/b&gt;&lt;br&gt;  Scans JSON for handles &amp;amp; rejects inline base64 data URIs&lt;br&gt;• &lt;b&gt;ImageMetadataValidator&lt;/b&gt; — Length, MIME &amp;amp; SHA-256 rules" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1235" y="138" width="405" height="240" as="geometry" />
        </mxCell>

        <!-- Enums & Exceptions -->
        <mxCell id="p3-ex" value="&lt;b&gt;Enums &amp;amp; Domain Exceptions (→ HTTP Status)&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#FECACA&quot;&gt;• &lt;b&gt;Enums&lt;/b&gt;: StorageHealthStatus (Healthy/Warning/Critical),&lt;br&gt;  TemplateComponentType&lt;br&gt;• &lt;b&gt;DomainValidationException&lt;/b&gt; → 400 Bad Request&lt;br&gt;• &lt;b&gt;ConcurrencyConflictException&lt;/b&gt; → 409 Conflict&lt;br&gt;• &lt;b&gt;EntityInUseException&lt;/b&gt; → 409 Conflict (image referenced)&lt;br&gt;• &lt;b&gt;StorageQuotaExceededException&lt;/b&gt; → 507 Insufficient Storage" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1235" y="428" width="405" height="230" as="geometry" />
        </mxCell>

        <!-- Domain Edges -->
        <mxCell id="e3-img-base" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;endArrow=block;endFill=0;endSize=10;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-img" target="p3-base">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="258" />
              <mxPoint x="345" y="339" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3-tpl-base" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;endArrow=block;endFill=0;endSize=10;strokeColor=#64748B;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontColor=#475569;labelBackgroundColor=#F8FAFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-tpl" target="p3-base">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="543" />
              <mxPoint x="345" y="426" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e3-img-bin" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#0D9488;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#0F766E;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-img" target="p3-bin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3-tpl-tref" value="1 : N (owns)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#7C3AED;strokeWidth=1.8;fontFamily=Segoe UI;fontSize=10.5;fontColor=#6D28D9;labelBackgroundColor=#F8FAFC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-tpl" target="p3-tref">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3-tref-img" value="logical ref (may span shards)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;dashed=1;dashPattern=5 4;strokeColor=#C026D3;strokeWidth=1.6;fontFamily=Segoe UI;fontSize=10;fontColor=#A21CAF;labelBackgroundColor=#F8FAFC;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-tref" target="p3-img">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="998" y="404" />
              <mxPoint x="644" y="404" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== FLOW A: SMART UPLOAD ROUTING ==================== -->
        <mxCell id="p3-flowA-grp" value="&lt;b&gt;Flow A — Smart Upload Routing (Stateless Scatter-Gather Offer via Dapr Pub/Sub + Direct Upload)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=12.5;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="30" y="712" width="1640" height="175" as="geometry" />
        </mxCell>

        <mxCell id="p3-fa1" value="&lt;b&gt;1. Client / SDK&lt;/b&gt;&lt;br&gt;POST /api/v1/pool/upload-offers&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Sends required file size in bytes&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="55" y="762" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fa2" value="&lt;b&gt;2. Receiving Node&lt;/b&gt;&lt;br&gt;DaprPoolCoordinator&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Registers correlationId in&lt;br&gt;PendingPoolReplyRegistry (5s timeout)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="385" y="762" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fa3" value="&lt;b&gt;3. Redis Pub/Sub Broadcast&lt;/b&gt;&lt;br&gt;content.pool.upload-offer&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;All pool nodes receive CloudEvent&lt;br&gt;and check local SQL quota&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="715" y="762" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fa4" value="&lt;b&gt;4. Healthy Node Replies&lt;/b&gt;&lt;br&gt;Dapr Invoke /pool/replies/{corrId}&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;First healthy node wins &amp;amp; returns&lt;br&gt;PoolNodeOfferDto (PublicBaseUrl)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1045" y="762" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fa5" value="&lt;b&gt;5. Direct Binary Upload&lt;/b&gt;&lt;br&gt;POST {winningNode}/api/v1/images&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Magic-byte check → SHA-256 →&lt;br&gt;SkiaSharp WebP preview → SQL&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1375" y="762" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e3-fa12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#059669;strokeWidth=2;" edge="1" parent="1" source="p3-fa1" target="p3-fa2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3-fa23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#EA580C;strokeWidth=2;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="p3-fa2" target="p3-fa3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3-fa34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#4F46E5;strokeWidth=2;" edge="1" parent="1" source="p3-fa3" target="p3-fa4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3-fa45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=16;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=gap;jumpSize=10;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="p3-fa4" target="p3-fa5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW B: CROSS-NODE PROXYING ==================== -->
        <mxCell id="p3-flowB-grp" value="&lt;b&gt;Flow B — Cross-Node Image Fetch / Stream / Delete Reference Check (Zero-Buffer Dapr Peer Proxy)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=12.5;fontColor=#3730A3;" vertex="1" parent="1">
          <mxGeometry x="30" y="912" width="1640" height="205" as="geometry" />
        </mxCell>

        <mxCell id="p3-fb1" value="&lt;b&gt;1. Client Request&lt;/b&gt;&lt;br&gt;GET /api/v1/images/node-2_{guid}/content&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Hits Node 1 (any entry node)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="55" y="990" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fb2" value="&lt;b&gt;2. Shard Resolution&lt;/b&gt;&lt;br&gt;StorageNodeTargetResolver&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Parses shard prefix &lt;i&gt;node-2&lt;/i&gt; ≠ local &lt;i&gt;node-1&lt;/i&gt;&lt;br&gt;(zero DB lookup needed)&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="385" y="990" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fb3" value="&lt;b&gt;3. Optional Locate Fallback&lt;/b&gt;&lt;br&gt;content.pool.locate-image&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Only if unsharded GUID is passed,&lt;br&gt;scatters via Redis to find owner&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;dashed=1;dashPattern=5 3;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="715" y="990" width="265" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p3-fb4" value="&lt;b&gt;4. Dapr Peer Invocation&lt;/b&gt;&lt;br&gt;DaprStorageNodeClient&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;POST/GET /v1.0/invoke/&lt;br&gt;contentservice-node-2/method/...&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4F46E5;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1045" y="990" width="265" height="100" as="geometry" />
        </mxCell>

