@* Ready-to-use modal window for browsing and selecting a layout template from ContentService. *@
<Modal IsOpen="@this.IsOpen"
       IsOpenChanged="@this.IsOpenChanged"
       Title="@this.Title"
       CloseOnBackdropClick="true"
       Modifier="@this.BuildModalModifier()">
        <ChildContent>
                @if (this.IsOpen)
                {
                        <Box Modifier="@this.BuildBodyModifier()">
                                @* Use OnSelectionChanged so toggling the blue dot or preview updates pending selection without closing the modal. *@
                                <ContentTemplateGallery SelectedTemplateId="@this._pendingSelectedTemplate?.Id"
                                                        OnSelectionChanged="@this.HandlePendingSelectionChanged"
                                                        DefaultComponentType="@this.DefaultComponentType"
                                                        AllowManage="@this.AllowManage"
                                                        PageSize="@this.PageSize" />
                        </Box>
                }
        </ChildContent>
        <FooterContent>
                <Row HorizontalArrangement="Arrangement.End"
                     VerticalAlignment="VerticalAlignment.Center"
                     Gap="0.75rem"
                     Modifier="@UIModifier.New.FillMaxWidth()">
                        <ActionButton Text="Luk"
                                      Variant="ActionButton.ButtonVariant.Outline"
                                      OnClick="@this.HandleCloseAsync" />
                        <ActionButton Text="Vælg"
                                      Variant="ActionButton.ButtonVariant.Solid"
                                      IsDisabled="@(this._pendingSelectedTemplate is null)"
                                      OnClick="@this.HandleConfirmSelectionAsync" />
                </Row>
        </FooterContent>
</Modal>

