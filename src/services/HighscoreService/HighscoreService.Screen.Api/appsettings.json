{
        "Logging": {
                "LogLevel": {
                        "Default": "Information",
                        "Microsoft.AspNetCore": "Warning"
                }
        },
        "AllowedHosts": "*",
        "ConnectionStrings": {
                "HighscoreDatabase": "Data Source=highscores_screen.db"
        },
        "HighscoreRanking": {
                "RollingRankingWindowHours": 5,
                "DefaultLeaderboardWindowHours": 5
        },
        "ScreenSync": {
                "CentralHubBaseUrl": null,
                "AdvertisedBaseUrl": null,
                "SubscribedGameIds": [],
                "RetentionDays": 7,
                "EnableUdpDiscovery": true,
                "UdpDiscoveryPort": 47890,
                "SyncIntervalSeconds": 30,
                "SyncBatchSize": 100
        }
}

