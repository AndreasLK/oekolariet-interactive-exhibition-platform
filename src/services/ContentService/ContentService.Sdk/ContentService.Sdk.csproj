<Project Sdk="Microsoft.NET.Sdk">

        <PropertyGroup>
                <TargetFramework>net11.0</TargetFramework>
                <ImplicitUsings>enable</ImplicitUsings>
                <Nullable>enable</Nullable>
                <!-- Emit XML docs and enforce CS1591/CS1573 from .editorconfig across all public SDK contracts. -->
                <GenerateDocumentationFile>true</GenerateDocumentationFile>
        </PropertyGroup>

        <ItemGroup>
                <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
                <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
                <PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />
        </ItemGroup>

</Project>

