        <mxCell id="p1-node2-sql" value="&lt;b&gt;SQL Server 2022 — sql-node-2 (:14332)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Independent Shard Database (EF Core + AutoMigrate)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• Isolated storage quota &amp;amp; failure domain&lt;br&gt;• Zero shared-DB coupling with Node 1&lt;br&gt;• Stores binaries &amp;amp; templates for &lt;i&gt;node-2&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;spacingTop=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1143" y="485" width="470" height="150" as="geometry" />
        </mxCell>

        <!-- Distributed Coordination Infrastructure Container -->
        <mxCell id="p1-infra-grp" value="&lt;b&gt;Distributed Pool Coordination Infrastructure&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontFamily=Segoe UI;fontSize=13;fontColor=#9A3412;" vertex="1" parent="1">
