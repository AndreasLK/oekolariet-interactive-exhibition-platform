<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

        <PropertyGroup>
                <TargetFramework>net11.0</TargetFramework>
                <Nullable>enable</Nullable>
                <ImplicitUsings>enable</ImplicitUsings>
                <!-- Emit XML documentation and enforce CS1591/CS1573 across all public web types. -->
                <GenerateDocumentationFile>true</GenerateDocumentationFile>
        </PropertyGroup>

        <ItemGroup>
                <PackageReference Include="ALKsPersonalUI" Version="3.1.3" />
                <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
                <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
        </ItemGroup>

        <ItemGroup>
                <ProjectReference Include="..\ContentService.Components\ContentService.Components.csproj" />
                <ProjectReference Include="..\ContentService.Sdk\ContentService.Sdk.csproj" />
        </ItemGroup>

</Project>

