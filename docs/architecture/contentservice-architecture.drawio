        </mxCell>

        <mxCell id="p2-domain" value="&lt;b&gt;ContentService.Domain&lt;/b&gt;  &lt;font color=&quot;#64748B&quot;&gt;(Pure Domain Core — Zero External Dependencies)&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;Entities&lt;/b&gt;: BaseEntity, ImageEntity, ImageBinaryEntity, TemplateEntity, TemplateImageReference&lt;br&gt;• &lt;b&gt;Value Objects&lt;/b&gt;: PictureReference, AlbumPath, ImageTags, TemplateJsonPictureScanner&lt;br&gt;• &lt;b&gt;Enums &amp;amp; Exceptions&lt;/b&gt;: StorageHealthStatus, TemplateComponentType, DomainValidation/Conflict/InUse/Quota" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
