<Project Sdk="Microsoft.NET.Sdk">

        <PropertyGroup>
                <TargetFramework>net10.0</TargetFramework>
                <ImplicitUsings>enable</ImplicitUsings>
                <Nullable>enable</Nullable>
                <!-- Emit XML docs and enforce CS1591/CS1573 from .editorconfig across all application contracts and use cases. -->
                <GenerateDocumentationFile>true</GenerateDocumentationFile>
        </PropertyGroup>

        <ItemGroup>
                <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
                <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
                <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
                <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.15" />
                <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
        </ItemGroup>

        <ItemGroup>
                <ProjectReference Include="..\ContentService.Domain\ContentService.Domain.csproj" />
        </ItemGroup>

</Project>

