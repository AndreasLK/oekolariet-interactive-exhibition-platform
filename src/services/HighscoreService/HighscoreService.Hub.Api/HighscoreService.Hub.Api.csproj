                </PackageReference>
                <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
        </ItemGroup>

        <ItemGroup>
                <ProjectReference Include="..\HighscoreService.Application\HighscoreService.Application.csproj" />
                <ProjectReference Include="..\HighscoreService.Hub.Infrastructure\HighscoreService.Hub.Infrastructure.csproj" />
