        <mxCell id="p1-redis" value="&lt;b&gt;Redis 7 Alpine (redis:6379)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;Dapr Pub/Sub Component: contentservice-pubsub&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#FDBA74&quot;&gt;• Stateless scatter-gather broadcast broker (no persistent app data)&lt;br&gt;• Topic 1: &lt;b&gt;content.pool.locate-image&lt;/b&gt; (find shard for unsharded GUID)&lt;br&gt;• Topic 2: &lt;b&gt;content.pool.upload-offer&lt;/b&gt; (solicit healthy node capacity)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="568" y="818" width="485" height="138" as="geometry" />
        </mxCell>

        <mxCell id="p1-placement" value="&lt;b&gt;Dapr Placement Service (dapr-placement:50006)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3730A3&quot;&gt;Sidecar Discovery &amp;amp; Service Mesh Control Plane&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#C7D2FE&quot;&gt;• Registers sidecar app IDs across the Docker network&lt;br&gt;• Enables direct peer invocation (&lt;i&gt;/v1.0/invoke/{appId}/method/...&lt;/i&gt;)&lt;br&gt;• Used for scatter-gather replies, binary proxying &amp;amp; reference checks" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="1125" y="818" width="505" height="138" as="geometry" />
        </mxCell>

