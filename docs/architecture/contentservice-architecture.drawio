        <mxCell id="p2-sdk" value="&lt;b&gt;ContentService.Sdk&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Typed HTTP Client Library&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#CBD5E1&quot;&gt;• &lt;b&gt;IContentServiceImageClient&lt;/b&gt; / ContentServiceImageClient&lt;br&gt;• &lt;b&gt;ImageUploadMultipartContentFactory&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ContentServiceEndpointUriResolver&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ActorHeaderResolver&lt;/b&gt; (&lt;i&gt;X-Actor-Id&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;HttpResponseErrorMapper&lt;/b&gt; → ContentServiceApiException&lt;br&gt;• Reusable by ContentService.Web &amp;amp; EditorService" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.5;align=left;spacingLeft=12;spacingRight=10;fontFamily=Segoe UI;fontSize=11;fontColor=#1E293B;" vertex="1" parent="1">
